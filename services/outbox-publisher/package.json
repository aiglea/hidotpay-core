{
  "name": "@hidotpay/outbox-publisher",
  "version": "0.2.47",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run": "node dist/cli/run-publisher.js",
