# 開發叢集連線字串只放在本機 .env，禁止提交真實帳密。
DATABASE_URL=postgresql://SQL_USER:PASSWORD@CLUSTER_HOST:26257/defaultdb?sslmode=verify-full
# 整合測試只能使用獨立資料庫，不能填入正式 DATABASE_URL。
HIDOTPAY_TEST_DATABASE_URL=postgresql://SQL_USER:PASSWORD@CLUSTER_HOST:26257/hidotpay_test?sslmode=verify-full
NODE_ENV=development
PORT=3001
# 開發預設只監聽本機；正式環境預設 0.0.0.0，供 AWS 容器接收流量。
HOST=127.0.0.1
# 開發版公開 Tunnel 必填；僅作為開發環境的額外入口保護，絕不可提交真值。
DEVELOPMENT_API_KEY=replace-with-a-long-random-secret

# production 必填；使用 Logto API resource 的 identifier 與 issuer。
LOGTO_AUDIENCE=https://api.example.invalid
LOGTO_ISSUER=https://your-tenant.logto.app/oidc
# 僅由伺服器設定提現手續費；key 為 network:asset_code，金額為最小單位字串。
WITHDRAWAL_FEE_SCHEDULE={"ethereum:USDT":"10000"}
