# 開發叢集連線字串只放在本機 .env，禁止提交真實帳密。
DATABASE_URL=postgresql://SQL_USER:PASSWORD@CLUSTER_HOST:26257/defaultdb?sslmode=verify-full
# 整合測試只能使用獨立資料庫，不能填入正式 DATABASE_URL。
HIDOTPAY_TEST_DATABASE_URL=postgresql://SQL_USER:PASSWORD@CLUSTER_HOST:26257/hidotpay_test?sslmode=verify-full
NODE_ENV=development
PORT=3001
# 開發預設只監聽本機；正式環境預設 0.0.0.0，供 AWS 容器接收流量。
HOST=127.0.0.1
# production 必填；使用 Logto API resource 的 identifier 與 issuer。
LOGTO_AUDIENCE=https://api.example.invalid
LOGTO_ISSUER=https://your-tenant.logto.app/oidc
# 僅限私有網路的 signer 地址衍生端點；此端點只回傳公開地址，不可存取私鑰。
SIGNER_DERIVATION_URL=https://signer.internal.example/v1/deposit-addresses
# API 對 signer 的最小權限服務憑證，從 Secret／鑰匙圈注入，禁止提交真值。
SIGNER_SERVICE_TOKEN=replace-with-private-signer-service-token
# 僅私有網路內的 OpenBao Transit；用來加密 P2P 收款資料，禁止使用 root token。
OPENBAO_TRANSIT_URL=https://openbao.internal.example
OPENBAO_TRANSIT_TOKEN=replace-with-p2p-payment-transit-token
# 僅由伺服器設定提現手續費；key 為 network:asset_code，金額為最小單位字串。
WITHDRAWAL_FEE_SCHEDULE={"ethereum:USDT":"10000"}
# 外部提現預設停用。只有 HSM／Web3Signer、測試網全流程與雙人覆核均完成後，才可受控地改成 true。
WITHDRAWALS_ENABLED=false
# 若 WITHDRAWALS_ENABLED=true，以下三項都必填；金額一律為最小單位整數字串。
WITHDRAWAL_DAILY_LIMIT_ATOMS=5000000
WITHDRAWAL_MAX_PER_WITHDRAWAL_ATOMS=2000000
WITHDRAWAL_WHITELIST_COOLDOWN_SECONDS=86400
# P2P 買方付款時限；到期仍未標記付款時，僅私有排程工作可原子退款給賣方。
P2P_PAYMENT_TIMEOUT_SECONDS=900
# 私有 P2P 排程單次最多處理筆數（1 至 1000），不可在公開 API 設定。
P2P_EXPIRY_BATCH_SIZE=100
