{
  "name": "@hidotpay/ledger-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/**/*.test.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
