{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hidotpay-native-ledger-staging",
  "main": "src/native-ledger-entry.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://hidotpay-wallet-ui.lgninhk.workers.dev,http://localhost:3000",
    "LEDGER_API_ENABLED": "true",
    "LOGTO_AUDIENCE": "https://api-dev.hidotpay.com",
    "LOGTO_ISSUER": "https://ngu7sy.logto.app/oidc",
    "WITHDRAWALS_ENABLED": "false"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cab293cdae3e461cb46ffbefd2b5415c"
    }
  ],
  "services": [
    {
      "binding": "DEPOSIT_SIGNER",
      "service": "hidotpay-deposit-signer-staging"
    }
  ]
}
